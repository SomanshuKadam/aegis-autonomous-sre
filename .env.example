MONGO_ROOT_USERNAME=aegisadmin
MONGO_ROOT_PASSWORD=<set-a-strong-password>
MONGO_DATABASE=mydatabase
N8N_ENCRYPTION_KEY=aegis-local-encryption-key-change-before-shared-use
N8N_USER=admin
N8N_PASSWORD=aegis-local-admin-password
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=
SIGNOZ_API_KEY=
CODEX_AUTH_FILE=/mnt/c/Users/Admin/.codex/auth.json
DOCKER_GID=986

# Aegis application and control-plane configuration
AEGIS_ENVIRONMENT=local
AEGIS_NORMAL_WORKLOAD_ENABLED=true
AEGIS_DEMO_WORKLOAD_ENABLED=false
AEGIS_DEMO_RUN_ID=
AEGIS_API_URL=http://api:8081
AEGIS_INVENTORY_URL=http://inventory:8082
AEGIS_SIGNOZ_URL=http://host.docker.internal:8080
AEGIS_ORCHESTRATOR_TOKEN=<set-a-local-orchestrator-token>
AEGIS_OPERATOR_TOKEN=<set-a-local-operator-token>
AEGIS_RUNNER_TOKEN=<set-a-local-runner-token>
AEGIS_SEARCH_RECOVERY_MS=2000
AEGIS_INVENTORY_RECOVERY_P95_MS=500
AEGIS_INVENTORY_RECOVERY_ERROR_RATE=0.01
AEGIS_QUEUE_RECOVERY_AGE_SECONDS=30
AEGIS_WORKER_MIN_CAPACITY=1
AEGIS_WORKER_MAX_CAPACITY=4
