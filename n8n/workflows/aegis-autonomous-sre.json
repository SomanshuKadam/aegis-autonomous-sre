{
  "name": "Aegis - Thin Incident Orchestrator",
  "nodes": [
    {
      "parameters": {"httpMethod": "POST", "path": "signoz-alert", "responseMode": "onReceived", "options": {}},
      "id": "alert-webhook", "name": "SigNoz Alert Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [-800, 0], "webhookId": "aegis-signoz-alert"
    },
    {
      "parameters": {"jsCode": "const payload = $json.body ?? $json; const alert = Array.isArray(payload.alerts) ? payload.alerts[0] : payload; const fingerprint = alert.fingerprint ?? alert.labels?.fingerprint ?? alert.labels?.alertname; if (!fingerprint) throw new Error('alert fingerprint is required'); return [{json:{source:'signoz', fingerprint:String(fingerprint), category:String(alert.labels?.category ?? payload.category ?? 'catalog_search'), target:{type:String(alert.labels?.target_type ?? payload.target_type ?? 'mongodb_collection')}}}];"},
      "id": "normalize-alert", "name": "Normalize Alert", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-560, 0]
    },
    {
      "parameters": {"method": "POST", "url": "={{ $env.AEGIS_API_URL + '/api/v1/orchestration/alerts' }}", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "Authorization", "value": "=Bearer {{ $env.AEGIS_ORCHESTRATOR_TOKEN }}"}]}, "sendBody": true, "specifyBody": "json", "jsonBody": "={{ $json }}", "options": {"retry": {"maxTries": 3}}},
      "id": "register-alert", "name": "Register Alert", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [-320, 0]
    },
    {
      "parameters": {"method": "POST", "url": "={{ $env.AEGIS_API_URL + '/api/v1/orchestration/notifications' }}", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ {incident_id: $json.incident_id, channel: 'n8n', delivered: true} }}", "options": {"retry": {"maxTries": 3}}},
      "id": "record-alert-notification", "name": "Record Alert Notification", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [-80, -80]
    },
    {
      "parameters": {"httpMethod": "POST", "path": "approval-resume", "responseMode": "lastNode", "options": {}},
      "id": "approval-webhook", "name": "Approval Resume Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [-320, 180], "webhookId": "aegis-approval-resume"
    },
    {
      "parameters": {"method": "POST", "url": "={{ $env.AEGIS_API_URL + '/api/v1/orchestration/notifications' }}", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ {incident_id: $json.body.incident_id, channel: 'approval-resume', delivered: true} }}", "options": {"retry": {"maxTries": 3}}},
      "id": "record-approval-resume", "name": "Record Approval Resume", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [-80, 180]
    }
  ],
  "connections": {
    "SigNoz Alert Webhook": {"main": [[{"node": "Normalize Alert", "type": "main", "index": 0}]]},
    "Normalize Alert": {"main": [[{"node": "Register Alert", "type": "main", "index": 0}]]},
    "Register Alert": {"main": [[{"node": "Record Alert Notification", "type": "main", "index": 0}]]},
    "Approval Resume Webhook": {"main": [[{"node": "Record Approval Resume", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"},
  "versionId": "aegis-thin-orchestrator-v1"
}
