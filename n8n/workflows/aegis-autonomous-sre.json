    {
      "parameters": {
        "jsCode": "const payload = $json.body ?? $json; const alert = Array.isArray(payload.alerts) ? payload.alerts[0] : payload; const labels = alert.labels ?? {}; const annotations = alert.annotations ?? {}; const fingerprint = alert.fingerprint ?? labels.fingerprint ?? labels.alertname ?? payload.fingerprint; if (!fingerprint) throw new Error('alert fingerprint is required'); const category = String(labels.category ?? payload.category ?? 'catalog_search').toLowerCase(); const targets = {catalog_search:{type:'mongodb_collection',database:'mydatabase',collection:'products',field:'search_text'},inventory_dependency:{type:'inventory_dependency'},order_backlog:{type:'order_worker'}}; if (!Object.hasOwn(targets, category)) throw new Error('unsupported incident category'); const target = payload.target ?? targets[category]; if (target.type !== targets[category].type) throw new Error('alert target does not match category'); const traceId = alert.trace_id ?? annotations.trace_id ?? labels.trace_id ?? payload.trace_id; if (typeof traceId !== 'string' || !/^[0-9a-f]{32}$/i.test(traceId)) throw new Error('SigNoz alert must contain a 32-character source trace ID'); return [{json:{source:'signoz',fingerprint:String(fingerprint),category,target,trace_id:traceId.toLowerCase(),alert_name:String(labels.alertname ?? payload.alert_name ?? category.replaceAll('_',' ') + ' threshold breached'),status:String(payload.status ?? alert.status ?? 'firing'),received_at:new Date().toISOString()}}];"
      },
