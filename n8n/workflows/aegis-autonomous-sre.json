      "parameters": {
        "jsCode": "const d=$json; const run=(d.agent_runs??[]).at(-1)??{}; const execution=(d.executions??[]).at(-1)??{}; const verification=(d.verifications??[]).at(-1)??{}; const approval=(d.approvals??[]).at(-1)??{}; const resolved=d.state==='RESOLVED'; const blocked=['BLOCKED','ESCALATED','FAILED'].includes(d.state); const title=resolved?'✅ Aegis Resolution':d.state==='APPROVAL_REQUIRED'?'⏸️ Approval Required':blocked?'🛑 Aegis Safely Stopped':'ℹ️ Aegis Update'; const button={type:'button',text:{type:'plain_text',text:'Open incident timeline',emoji:true},url:'http://localhost:3000/ops/incidents/'+d.incident_id}; if(resolved) button.style='primary'; return [{json:{text:'Aegis incident '+d.incident_id+' reached '+d.state,blocks:[{type:'header',text:{type:'plain_text',text:title,emoji:true}},{type:'section',fields:[{type:'mrkdwn',text:'*State*\\n'+d.state},{type:'mrkdwn',text:'*Category*\\n'+d.category},{type:'mrkdwn',text:'*Codex action*\\n`'+(run.selected_action??'none')+'`'},{type:'mrkdwn',text:'*Execution*\\n'+(execution.state??(approval.state?'Waiting for '+approval.state:'Not executed'))}]},{type:'section',text:{type:'mrkdwn',text:'*Diagnosis*\\n'+(run.diagnosis??'No diagnosis recorded')+'\\n\\n*Verification*\\n'+(verification.outcome??(d.state==='APPROVAL_REQUIRED'?'Pending explicit approval':'No verification performed'))}},{type:'context',elements:[{type:'mrkdwn',text:'Trace `'+(d.trace_id??'unavailable')+'` • Incident `'+d.incident_id+'`'}]},{type:'actions',elements:[button]}]}}];"
