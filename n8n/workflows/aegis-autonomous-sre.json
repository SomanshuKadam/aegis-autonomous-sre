    {
      "parameters": {
        "jsCode": "const raw=$json.stdout?.trim(); if(!raw) throw new Error('Codex investigation returned no output'); const result=JSON.parse(raw.split('\\n').at(-1)); const incident=$('Register Deduplicated Alert').item.json.incident_id; const source=$('Normalize Correlated Alert').item.json; if(result.incident_id!==incident || result.trace_id!==source.trace_id || result.category!==source.category) throw new Error('Codex output correlation mismatch'); const expected={catalog_search:'mongo.create_search_index@1',inventory_dependency:'inventory.restore_capacity@1',order_backlog:'worker.set_capacity@1'}[source.category]; if(result.safe_to_proceed && result.selected_action!==expected) throw new Error('Codex selected an unregistered action for this incident'); if(!result.safe_to_proceed && result.selected_action!=='none') throw new Error('unsafe analysis selected a mutation'); return [{json:result}];"
      },
